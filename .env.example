# Local URL, or your exact HTTPS deployment origin.
APP_URL=http://localhost:3000
# Pooled URL for the running app. Direct URL for migrations and admin scripts.
DATABASE_URL=postgresql://bytebites:REPLACE_PASSWORD@localhost:5432/bytebites?connection_limit=5
DIRECT_URL=postgresql://bytebites:REPLACE_PASSWORD@localhost:5432/bytebites
# Used only by local Docker Compose. Generate a new random value.
POSTGRES_PASSWORD=REPLACE_PASSWORD
# Generate with npm run keys:generate. Retain this key securely for existing records.
DATA_ENCRYPTION_KEY=
# Resend requires a verified sending domain. Keep blank until connected.
RESEND_API_KEY=
MAIL_FROM=
# Optional private S3-compatible reference-image storage. Never use a public bucket.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SSE=
# Bootstrap a staff account with a unique 12+ character password, then remove these.
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=
