{
  "name": "bytebites-connected",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx scripts/seed.ts",
    "staff:create": "node --import tsx scripts/create-staff.ts",
    "keys:generate": "node scripts/generate-keys.mjs",
    "retention:report": "node --import tsx scripts/retention-report.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:flows": "node --import tsx tests/flows.ts",
    "typecheck": "tsc --noEmit",
    "check:connections": "node --import tsx scripts/check-connections.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "16.6.1",
    "file-type": "21.3.4",
    "lucide-react": "1.31.0",
    "next": "16.4.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
